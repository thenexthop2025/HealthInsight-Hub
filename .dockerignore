# Git version control system files
.git
.gitignore
.gitattributes

# Docker specific files
.dockerignore
docker-compose.yml
docker-compose.*.yml

# Deployment scripts (not needed in container)
start.sh
start_prod.sh

# Documentation
README.md
QUICK_START.md
USAGE.md

# Node.js dependency directory and build output
# These are handled inside the Dockerfile during the build stage
frontend/node_modules
frontend/build

# Python bytecode, cache, and virtual environments
backend/__pycache__
__pycache__
backend/venv
backend/env
venv/
env/
*.pyc
*.pyo
*.pyd

# IDE and OS specific files
.idea/
.vscode/
.DS_Store
*.swp
*.swo
*~

# Test reports, logs, and artifacts
.play-mcp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Environment files
.env
.env.*
env.example

# Database files
*.db
*.db.bak
*.sqlite
*.sqlite3

# Generated reports (will be recreated in production)
backend/generated_reports/*.pdf
backend/generated_reports/*.docx

# Uploads (should use external storage in production)
backend/uploads/*
uploads/*

# Cache and temporary files
backend/config/*.json
backend/celerybeat-schedule
.pytest_cache/
.coverage
htmlcov/

# Sample data (not needed in production)
sample_data/
