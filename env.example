# =============================================================================
# HealthInsight Hub - 本地部署环境变量示例
# 复制为 .env 后修改：cp env.example .env
# 或运行：./generate-env.sh
# =============================================================================

# Database Configuration
POSTGRES_DB=disease_analysis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_strong_password

# Backend Configuration
DATABASE_URL=postgresql://postgres:change_me_to_a_strong_password@postgres:5432/disease_analysis
SECRET_KEY=replace_with_a_long_random_string_at_least_32_chars
TZ=Asia/Shanghai

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Optional external API keys
WHO_API_KEY=
